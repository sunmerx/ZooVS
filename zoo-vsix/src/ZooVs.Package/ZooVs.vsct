<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidZooVsPackage">
    <Buttons>
      <!-- Tools 菜单 -->
      <Button guid="guidZooVsCommandSet" id="cmdidOpenZooToolWindow" priority="0x0500" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS"/>
        <Strings>
          <ButtonText>Open ZooVS Chat</ButtonText>
        </Strings>
      </Button>
      <!-- View > Other Windows -->
      <Button guid="guidZooVsCommandSet" id="cmdidOpenZooToolWindowView" priority="0x0501" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1"/>
        <Strings>
          <ButtonText>ZooVS Chat</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidZooVsPackage" value="{c3d9e2a1-7f4b-4c68-9a5d-8e1b2c3d4f6a}"/>
    <GuidSymbol name="guidZooVsCommandSet" value="{e5f9a4c3-9b6d-4e8a-cf7a-0a3d4e5f6b8c}">
      <IDSymbol name="cmdidOpenZooToolWindow" value="0x0100"/>
      <IDSymbol name="cmdidOpenZooToolWindowView" value="0x0101"/>
    </GuidSymbol>
  </Symbols>

</CommandTable>
